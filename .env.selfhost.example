# Completed automatically by install.sh — edit only if you know what you change.

# Public addresses (what browsers use)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
APP_PORT=3000

# Backend keys (generated by install.sh)
ANON_KEY=
SERVICE_ROLE_KEY=

# Microsoft Entra ID (UPB Microsoft 365 sign-in) — from Azure portal → App registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# Optional: AI features (silkscreen reading, AI rule drafts). Any OpenAI-compatible API.
# For a local model in the UPB network (Ollama/vLLM), point OPENAI_BASE_URL at it, e.g.
# OPENAI_BASE_URL=http://ollama.lab.upb.ro:11434/v1  and AI_MODEL=qwen2.5-vl
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Air-Gapped Exam Mode (isolated lab network): external services (Google, cloud AI) are
# bypassed gracefully and official submissions require one-time exam codes generated
# by the teacher in Maintenance → Mod examen. Sync resumes automatically on reconnect.
EXAM_MODE=0

# Optional: Google Drive / Sheets. Either an OAuth refresh token (recommended, uses your Drive quota)...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ...or a service account JSON on one line (share folders/sheets with its e-mail)
GOOGLE_SERVICE_ACCOUNT_JSON=
