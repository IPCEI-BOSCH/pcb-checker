# PCB Checker & CAM — configurație server local
# Completat automat de selfhost/install.sh — editează doar dacă știi ce schimbi.

# Mod de execuție: selfhost = server local (Docker), cloud = Lovable Cloud
DEPLOYMENT_MODE=selfhost
VITE_DEPLOYMENT_MODE=selfhost

# Adrese publice (ce folosesc browserele)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
APP_PORT=3000

# Nginx (HTTPS pe LAN / domeniu)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MAX_UPLOAD_MB=500

# Secrete (generate automat de install.sh)
POSTGRES_PASSWORD=
JWT_SECRET=
# Cod unic cerut de /setup la crearea primului administrator (generat de install.sh)
SETUP_TOKEN=
SESSION_SECRET=

# Chei backend (generate de install.sh)
ANON_KEY=
SERVICE_ROLE_KEY=

# Autentificare locală (email + parolă, bcrypt în PostgreSQL) — activă implicit pe self-host
ALLOWED_EMAIL_DOMAINS=@student.upb.ro,@upb.ro,@cetti.ro
# Cod de înrolare de laborator (opțional): dacă e setat, studenții trebuie să-l introducă la înregistrare
LAB_INVITE_CODE=
# Contul inițial de administrator poate fi creat și din wizardul /setup
ADMIN_EMAIL=

# Microsoft Entra ID (conectare UPB Microsoft 365) — din Azure portal → App registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# Funcții AI (citire serigrafie, reguli propuse de AI). Orice API OpenAI-compatibil.
# Pentru model local în rețeaua UPB (Ollama/vLLM):
#   OPENAI_BASE_URL=http://<server-ollama>:11434/v1   OPENAI_API_KEY=ollama   AI_MODEL=qwen2.5-vl
# Sau pornește profilul Docker inclus: docker compose -f selfhost/docker-compose.yml --profile ai up -d
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Mod examen air-gapped (rețea izolată de laborator): serviciile externe sunt ocolite
# grațios, iar predarea oficială cere coduri unice generate de profesor (Mentenanță → Mod examen)
EXAM_MODE=0

# Google Drive / Sheets (opțional): OAuth refresh token (recomandat)...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ...sau cont de serviciu JSON pe o linie (partajează folderele/foile cu email-ul lui)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Stocare locală (volum Docker persistent pentru arhivele ZIP și predările oficiale)
STORAGE_ROOT=/var/lib/pcb-checker/storage
